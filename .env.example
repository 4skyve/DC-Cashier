# Ambil dari Supabase Project Settings > Database > Connection string

# DATABASE_URL: dipakai app saat runtime (query biasa) -> connection pooler, port 6543
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: WAJIB ada, dipakai khusus untuk `prisma db push` / `migrate` -> direct connection, port 5432
# (db push akan STUCK/hang kalau ini tidak diisi atau masih pakai port 6543)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
